# Copy this file, rename the copy to .env, and paste your own keys after the = signs.
# Never share .env, never paste it into a chat, never show it in a screenshot.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. If Google does not recognise this name, the app
# asks Google which Flash models your key can use and picks the best one
# automatically (the terminal window shows which one it chose).
GEMINI_MODEL=gemini-flash-latest

# Free key from Tavily: https://app.tavily.com (1,000 free credits a month)
TAVILY_API_KEY=

# RECOMMENDED free backup AI service, used when Gemini is busy.
# Free key from Groq, no card needed: https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL third AI service, used when Gemini and Groq are both busy.
# Free key from Mistral: https://console.mistral.ai (choose the free "Experiment" plan).
MISTRAL_API_KEY=

# Speed or quality: by default the fast Flash-Lite model is tried first.
# Set AI_SPEED=quality to try GEMINI_MODEL first (slower, often busy).
AI_SPEED=fast

# Which AI service to try first: gemini (default), groq or mistral.
AI_PROVIDER=gemini
